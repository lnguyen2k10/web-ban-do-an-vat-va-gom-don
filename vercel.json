{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["hnd1"],
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?__lees_route=:path*"},
    {"source": "/dat-hang", "destination": "/index.html"},
    {"source": "/tra-don", "destination": "/track.html"},
    {"source": "/admin", "destination": "/admin.html"}
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; base-uri 'none'; form-action 'self'"}
      ]
    }
  ]
}
